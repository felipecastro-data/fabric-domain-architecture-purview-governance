{
  "name": "fabric-mesh",
  // Plain Debian base: uv installs Python 3.12 from .python-version.
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/terraform:1": { "tflint": "latest" },
    "ghcr.io/devcontainers/features/powershell:1": { "modules": "ExchangeOnlineManagement" },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/azure-cli:1": {}
  },
  "remoteEnv": { "PATH": "${containerEnv:PATH}:/home/vscode/.local/bin" },
  "postCreateCommand": "curl -LsSf https://astral.sh/uv/0.13.4/install.sh | sh && make setup UV=/home/vscode/.local/bin/uv",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "hashicorp.terraform",
        "ms-vscode.powershell",
        "github.vscode-github-actions"
      ]
    }
  }
}
